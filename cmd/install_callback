#!/bin/bash
# fnOS install 回调 —— 保存向导输入的 Web 访问口令（若有）
set -u

APPNAME="magpie"
_ADMIN=""
for _v in /vol[0-9]*; do
    [ -d "${_v}/@appdata/${APPNAME}" ] && _ADMIN="${_v}/@appdata/${APPNAME}" && break
done
[ -n "$_ADMIN" ] || _ADMIN="${TRIM_PKGVAR:-/tmp}"
mkdir -p "$_ADMIN" 2>/dev/null
exec >> "${_ADMIN}/hook.log" 2>&1

echo "=== install_callback $(date '+%F %T') uid=$(id -u) user=$(id -un) ==="
env | grep -i '^wizard_' || echo "(no wizard params)"

# 若用户在向导中设置了口令（且未存在旧 key），预写入 web.key
if [ -n "${wizard_web_key:-}" ]; then
    if [ ! -s "${_ADMIN}/web.key" ]; then
        printf '%s\n' "$wizard_web_key" > "${_ADMIN}/web.key"
        chmod 600 "${_ADMIN}/web.key" 2>/dev/null || true
        echo "已从向导初始化 web.key"
    fi
fi

exit 0
